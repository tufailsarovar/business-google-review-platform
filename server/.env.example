# ==========================================
# TapRating Server Environment Configuration
# ==========================================

# Server
PORT=5000
NODE_ENV=development

# Client
CLIENT_URL=http://localhost:5173

# ==========================================
# MongoDB
# ==========================================

MONGO_URI=mongodb://127.0.0.1:27017/business-google-review-platform

# ==========================================
# JWT Authentication
# ==========================================

JWT_SECRET=your_super_secure_jwt_secret
JWT_EXPIRES_IN=7d

# ==========================================
# Password Reset / Email Verification
# ==========================================

EMAIL_VERIFICATION_EXPIRES_MINUTES=30
PASSWORD_RESET_EXPIRES_MINUTES=15

# ==========================================
# SMTP
# ==========================================

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password
SMTP_FROM=TapRating <your_email@gmail.com>

# ==========================================
# Support SMTP
# ==========================================

SUPPORT_SMTP_HOST=smtp.gmail.com
SUPPORT_SMTP_PORT=587
SUPPORT_SMTP_SECURE=false
SUPPORT_SMTP_USER=your_support_email@gmail.com
SUPPORT_SMTP_PASSWORD=your_support_app_password
SUPPORT_EMAIL=your_support_email@gmail.com

# ==========================================
# OpenAI
# ==========================================

OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini

# ==========================================
# Cloudinary
# ==========================================

CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ==========================================
# Google Review
# ==========================================

GOOGLE_REVIEW_URL=
GOOGLE_MAPS_API_KEY=

# ==========================================
# Admin
# ==========================================

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_this_admin_password

# ==========================================
# Security
# ==========================================

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100